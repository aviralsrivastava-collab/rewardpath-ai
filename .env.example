# ==============================================================================
# REWARDPATH COMMAND CENTER AI — ENVIRONMENT VARIABLES EXAMPLE FILE
# ==============================================================================
# IMPORTANT SECURITY DIRECTIVE:
# Copy this file to .env.local for local development.
# NEVER commit .env or .env.local to version control.
# NO secret keys should exist as hardcoded strings anywhere in the source code.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. SERVER-SIDE AI & LLM PROVIDER KEYS (SERVER-SIDE ONLY - NEVER EXPOSE TO CLIENT)
# ------------------------------------------------------------------------------
OPENAI_API_KEY=YOUR_OPENAI_API_KEY_HERE

# ------------------------------------------------------------------------------
# 2. SERVER-SIDE ADMIN AUTHENTICATION & REINDEX KEYS (SERVER-SIDE ONLY)
# ------------------------------------------------------------------------------
ADMIN_SECRET_KEY=YOUR_SECURE_ADMIN_BEARER_TOKEN_HERE

# ------------------------------------------------------------------------------
# 3. DATABASE CONNECTION STRINGS (SERVER-SIDE ONLY)
# ------------------------------------------------------------------------------
DATABASE_URL=postgresql://user:password@localhost:5432/rewardpath_db?sslmode=require

# ------------------------------------------------------------------------------
# 4. SUPABASE KEYS & ROW LEVEL SECURITY (RLS)
# - Anon Key is public-safe ONLY when Row Level Security (RLS) is enabled on all tables.
# - Service Role Key MUST NEVER be exposed client-side under any circumstances.
# ------------------------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=YOUR_SUPABASE_ANON_KEY_HERE
SUPABASE_SERVICE_ROLE_KEY=YOUR_SUPABASE_SERVICE_ROLE_KEY_SERVER_ONLY

# ------------------------------------------------------------------------------
# 5. STRIPE PAYMENT KEYS
# - Only publishable keys may use NEXT_PUBLIC_ prefix.
# - Secret keys must remain server-side only.
# ------------------------------------------------------------------------------
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_YOUR_PUBLISHABLE_KEY_HERE
STRIPE_SECRET_KEY=sk_test_YOUR_SECRET_KEY_SERVER_ONLY

# ------------------------------------------------------------------------------
# 6. APPLICATION CONFIGURATION
# ------------------------------------------------------------------------------
NEXT_PUBLIC_APP_URL=http://localhost:3000
NODE_ENV=development
